{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/dramadownloader-python",
      "destination": "/api/dramadownloader"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index?route=$1"
    }
  ],
  "functions": {
    "api/dramadownloader.py": {
      "maxDuration": 60
    }
  }
}
