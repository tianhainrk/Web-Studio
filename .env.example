# Vercel > Project Settings > Environment Variables
STUDIO_PASSWORD=replace-with-at-least-12-characters
SESSION_SECRET=replace-with-a-32-or-more-character-random-secret
# Google Cloud OAuth Client ID (Web application), Drive API enabled, authorized JS origin set to Vercel domain
GOOGLE_CLIENT_ID=
# Optional upstream device profile
PINE_DEVICE_TYPE=iPhone17,3
PINE_OS_VERSION=26.0
PINE_OS_API=26

# Verified native ranking country selector; defaults to VN even if unset.
PINE_CARRIER_REGION=VN

# ==============================================
# AI Fanpage Publisher v2 (server-side only)
# ==============================================
# Exact HTTPS origin after you deploy, without path or trailing slash.
STUDIO_PUBLIC_URL=https://your-new-project.vercel.app

# Supabase database; apply sql/publisher-schema.sql once.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PUBLISHER_ENCRYPTION_KEY=

# Meta for Developers: configure the corresponding OAuth callback URLs.
META_APP_ID=
META_APP_SECRET=
# Set to a Meta Graph API version supported by your Meta app.
META_GRAPH_VERSION=v24.0

# Server-side OAuth, in addition to the existing browser Google Drive integration.
GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_ID is configured above.

# Model AI keys are NEVER entered into the website's client-side controls.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
MUSE_API_KEY=
MUSE_MODEL=muse-spark-1.3
