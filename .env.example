# Vercel > Project Settings > Environment Variables
STUDIO_PASSWORD=replace-with-at-least-12-characters
SESSION_SECRET=replace-with-a-32-or-more-character-random-secret
# Google Cloud OAuth Client ID (Web application), Drive API enabled, authorized JS origin set to Vercel domain
GOOGLE_CLIENT_ID=
# Optional upstream device profile
PINE_DEVICE_TYPE=iPhone17,3
PINE_OS_VERSION=26.0
PINE_OS_API=26

# Verified native ranking country selector; defaults to VN even if unset.
PINE_CARRIER_REGION=VN
